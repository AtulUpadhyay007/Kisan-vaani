

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0
SECRET_KEY=

# Data Storage & Directory Paths
DATA_DIR=data

# Language & Region Defaults
DEFAULT_DISTRICT=Amritsar
DEFAULT_STATE=Punjab
DEFAULT_LANGUAGE=pa
LANGUAGES_SUPPORTED=pa,hi,hinglish

# Safety & Grounding Controls
STRICT_ZERO_HALLUCINATION=true
MAX_LATENCY_MS=6000
OFFLINE_CACHE_ENABLED=true

# Government Helplines & Contacts
IVR_TOLLFREE=1800-180-1551
KVK_AMRITSAR_PHONE=0183-2580790
PUNJAB_MANDI_BOARD_PHONE=0183-2581240

# Optional: Google Gemini API Key for Multilingual Query Intent & LLM Grounding
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real-Time Weather API Configuration (OpenWeatherMap / WeatherAPI / Open-Meteo)
WEATHER_API_KEY=
WEATHER_PROVIDER=auto
